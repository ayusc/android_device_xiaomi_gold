From b1cbcc9e48d40e0f71cc614b65b05a07dc67c303 Mon Sep 17 00:00:00 2001
From: ayusc <ayuschatterjee2003@gmail.com>
Date: Mon, 9 Nov 2026 19:16:27 +0000
Subject: [PATCH] base: Add property virtualizer and security hooks

---
 core/java/android/app/ActivityThread.java     |  38 +-
 core/jni/Android.bp                           |   2 +
 core/jni/com_android_internal_os_Zygote.cpp   |  35 ++
 core/jni/property_virtualizer.cpp             | 541 ++++++++++++++++++
 .../keystore2/AndroidKeyStoreSpi.java         |   5 +-
 5 files changed, 609 insertions(+), 12 deletions(-)
 create mode 100644 core/jni/property_virtualizer.cpp

diff --git a/core/java/android/app/ActivityThread.java b/core/java/android/app/ActivityThread.java
index 1e47a539353f..2c88ed100d74 100644
--- a/core/java/android/app/ActivityThread.java
+++ b/core/java/android/app/ActivityThread.java
@@ -8228,14 +8228,36 @@ public final class ActivityThread extends ClientTransactionHandler
 
         GamePropsSpoofService.getInstance().spoofForPackage(data.appInfo.packageName);
 
-        PlayIntegritySpoofService pifService = PlayIntegritySpoofService.getInstance();
-        if (pifService.shouldSpoof(data.processName)) {
-            pifService.spoofBuildFields(data.processName);
-            if (pifService.isSpoofProviderEnabled()) {
-                pifService.spoofProvider(data.processName);
-            }
-            if (pifService.isSpoofSignatureEnabled()) {
-                pifService.spoofSignature(data.processName);
+        if ("com.google.android.gms.unstable".equals(data.processName) || "com.android.vending".equals(data.processName)) {
+            try {
+                String[] strProps = {"FINGERPRINT", "MANUFACTURER", "BRAND", "MODEL", "PRODUCT", "DEVICE", "ID", "TYPE", "TAGS"};
+                String[] strValues = {
+                    "google/cubs_beta/cubs:CANARY/ZP11.260918.007/16484274:user/release-keys",
+                    "Google", "google", "Pixel 11", "cubs_beta", "cubs", "ZP11.260918.007", "user", "release-keys"
+                };
+                for (int i = 0; i < strProps.length; i++) {
+                    java.lang.reflect.Field f = android.os.Build.class.getDeclaredField(strProps[i]);
+                    f.setAccessible(true);
+                    f.set(null, strValues[i]);
+                }
+                
+                String[] verProps = {"RELEASE", "INCREMENTAL", "SECURITY_PATCH"};
+                String[] verValues = {"CANARY", "16484274", "2026-10-05"};
+                for (int i = 0; i < verProps.length; i++) {
+                    java.lang.reflect.Field f = android.os.Build.VERSION.class.getDeclaredField(verProps[i]);
+                    f.setAccessible(true);
+                    f.set(null, verValues[i]);
+                }
+
+                try {
+                    java.lang.reflect.Field sdkInt = android.os.Build.VERSION.class.getDeclaredField("DEVICE_INITIAL_SDK_INT");
+                    sdkInt.setAccessible(true);
+                    sdkInt.set(null, 37);
+                } catch (NoSuchFieldException ignored) { }
+
+                android.util.Log.i("PIF", "Successfully spoofed Java Build properties for " + data.processName);
+            } catch (Exception e) {
+                android.util.Log.e("PIF", "Failed to spoof Java Build properties", e);
             }
         }
 
diff --git a/core/jni/Android.bp b/core/jni/Android.bp
index 7b9844f7df73..54d51e3e361a 100644
--- a/core/jni/Android.bp
+++ b/core/jni/Android.bp
@@ -274,6 +274,8 @@ cc_defaults_for_libandroid_runtime {
                 "com_android_internal_os_ZygoteInit.cpp",
                 "com_android_internal_security_VerityUtils.cpp",
                 "com_android_internal_util_ArrayUtils.cpp",
+                "property_virtualizer.cpp",
+                "pif_config.cpp",
                 "hwbinder/EphemeralStorage.cpp",
                 "fd_utils.cpp",
                 "android_hardware_input_InputWindowHandle.cpp",
diff --git a/core/jni/com_android_internal_os_Zygote.cpp b/core/jni/com_android_internal_os_Zygote.cpp
index 15a7ee4a0a39..ee099c7d8f1f 100644
--- a/core/jni/com_android_internal_os_Zygote.cpp
+++ b/core/jni/com_android_internal_os_Zygote.cpp
@@ -87,6 +87,7 @@
 #include "fd_utils.h"
 #include "filesystem_utils.h"
 #include "nativebridge/native_bridge.h"
+#include "property_virtualizer.hpp"
 
 #if defined(__BIONIC__)
 #include <android/dlext_private.h>
@@ -2195,6 +2196,40 @@ static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids,
     // Unset the SIGCHLD handler, but keep ignoring SIGHUP (rationale in SetSignalHandlers).
     UnsetChldSignalHandler();
 
+    if (!is_system_server && nice_name.has_value()) {
+        std::string process_name_str = nice_name.value();
+        
+        if (process_name_str == "com.google.android.gms.unstable") {
+            pif::Config config;
+            config.spoofBuild = true;
+            config.spoofProps = true;
+            config.deviceInitialSdkInt = "37";
+            config.securityPatch = "2026-10-05";
+            config.buildId = "ZP11.260918.007";
+            config.debug = true;
+            
+            config.propMap["FINGERPRINT"] = "google/cubs_beta/cubs:CANARY/ZP11.260918.007/16484274:user/release-keys";
+            config.propMap["MANUFACTURER"] = "Google";
+            config.propMap["BRAND"] = "google";
+            config.propMap["MODEL"] = "Pixel 11";
+            config.propMap["DEVICE"] = "cubs";
+            config.propMap["PRODUCT"] = "cubs_beta";
+            config.propMap["ID"] = "ZP11.260918.007";
+            config.propMap["RELEASE"] = "CANARY";
+            config.propMap["INCREMENTAL"] = "16484274";
+            config.propMap["TYPE"] = "user";
+            config.propMap["TAGS"] = "release-keys";
+            config.propMap["SECURITY_PATCH"] = "2026-10-05";
+            
+            bool success = pif::property_virtualizer::install(config);
+            if (!success) {
+                ALOGE("Virtualization failed for %s", process_name_str.c_str());
+            } else {
+                ALOGI("Virtualization succeeded for %s", process_name_str.c_str());
+            }
+        }
+    }
+
     if (is_system_server) {
         env->CallStaticVoidMethod(gZygoteClass, gCallPostForkSystemServerHooks, runtime_flags);
         if (env->ExceptionCheck()) {

diff --git a/keystore/java/android/security/keystore2/AndroidKeyStoreSpi.java b/keystore/java/android/security/keystore2/AndroidKeyStoreSpi.java
index b1f3ee37be57..7350c9b82c28 100644
--- a/keystore/java/android/security/keystore2/AndroidKeyStoreSpi.java
+++ b/keystore/java/android/security/keystore2/AndroidKeyStoreSpi.java
@@ -187,9 +187,6 @@ public class AndroidKeyStoreSpi extends KeyStoreSpi {
 
     @Override
     public Certificate[] engineGetCertificateChain(String alias) {
-        if (PlayIntegritySpoofService.shouldBlockCertificateChain()) {
-            throw new UnsupportedOperationException();
-        }
 
         KeyEntryResponse response = getKeyMetadata(alias);
 
@@ -222,7 +219,7 @@ public class AndroidKeyStoreSpi extends KeyStoreSpi {
 
         caList[0] = leaf;
 
-        return hackCertificateChainIfNeeded(alias, caList);
+        return caList;
     }
 
     @Override
